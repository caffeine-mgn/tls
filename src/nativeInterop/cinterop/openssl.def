package = openssl3
language = C

// OpenSSL 3.x core + libssl declarations for the TLS state machine.
// We list headers explicitly rather than #include'ing them — that
// way the cinterop only pulls in the headers we name (no recursive
// <bits/floatn.h> on aarch64 / <bits/sys_err.h> on glibc 2.34+).
// Combined with headerFilter = openssl/**, only the openssl/ subtree
// is parsed.

headers = openssl/ssl.h openssl/err.h openssl/bio.h openssl/buffer.h \
          openssl/x509.h openssl/evp.h openssl/pem.h openssl/rsa.h \
          openssl/ec.h openssl/bn.h openssl/objects.h
headerFilter = openssl/**

---

// OpenSSL 3 dropped the *_buffer helpers. The cinterop maps C's
// `int` to Int and `unsigned char *` to UByte, so we wrap each call
// site in a C function with the original signatures (long long len,
// unsigned char *d) so Kotlin can pass ByteArray pointers.
int pw_SSL_CTX_use_certificate_ASN1_call(SSL_CTX *ctx, long long len, const unsigned char *d) {
    return SSL_CTX_use_certificate_ASN1(ctx, len, d);
}
EVP_PKEY *pw_d2i_PrivateKey_PKCS8(SSL_CTX *ctx, const unsigned char *d, long long len) {
    // Decode a PKCS#8 PrivateKeyInfo (which is what BouncyCastle's
    // KeyPair.private.encoded produces) into an EVP_PKEY, then attach
    // it to the SSL_CTX.
    const unsigned char *p = d;
    EVP_PKEY *pkey = d2i_PrivateKey(EVP_PKEY_NONE, NULL, &p, len);
    if (pkey == NULL) return NULL;
    if (SSL_CTX_use_PrivateKey(ctx, pkey) != 1) {
        EVP_PKEY_free(pkey);
        return NULL;
    }
    return pkey;
}

// Wrapper for SSL_CTX_set_verify that hides the function-pointer callback
// (Kotlin/Native cinterop can't pass null callbacks cleanly).
static int pw_noop_verify_cb(int ok, X509_STORE_CTX *ctx) { return ok; }
void pw_SSL_CTX_set_verify(SSL_CTX *ctx, int mode) {
    SSL_CTX_set_verify(ctx, mode, pw_noop_verify_cb);
}
int pw_SSL_CTX_set_default_verify_paths(SSL_CTX *ctx) {
    return SSL_CTX_set_default_verify_paths(ctx);
}
int pw_BIO_set_close(BIO *b, int c) {
    return BIO_set_close(b, c);
}
int pw_SSL_set_tlsext_host_name(SSL *s, const char *name) {
    return SSL_set_tlsext_host_name(s, name);
}

// Export the stderr pointer so Kotlin can use it.
// (Removed: the FILE* type pulls in <stdio.h> on every target, and
// the cross-platform stdio.h definitions break cinterop parsing
// on mingw + android ndk. We don't actually need the pointer —
// any code that needs to log to stderr can do so through Kotlin.)
